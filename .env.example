# Supabase → Project settings → API
SUPABASE_URL=https://your-project.supabase.co
# The public anon / publishable key. It can only call submit_brief(), so it is safe.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: WhatsApp alert for every new brief, via CallMeBot (free, personal use).
# Get the key by messaging the CallMeBot bot from your WhatsApp; see README.
CALLMEBOT_APIKEY=
WHATSAPP_NOTIFY_PHONE=923477309441
